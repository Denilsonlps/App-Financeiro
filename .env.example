# Copie para .env (local) ou cadastre na Vercel em Settings → Environment Variables.
# Valores em Supabase → Project Settings → API (ou "Connect" no topo do painel).
# Use a chave pública ("anon public" ou "publishable"), nunca a service_role/secret.
# Sem estas variáveis o app roda no modo local (dados só no navegador).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
